---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "25 November 2026";
---

<Layout
  title="Terms & Conditions"
  description="Terms and Conditions for Mint Prints - Read our terms of service for 3D printing, laser cutting, and custom design services."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-gray-50 to-white dark:from-gray-800 dark:to-gray-900 py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Terms & Conditions
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Last updated: {lastUpdated}
      </p>
    </div>
  </section>

  <!-- Terms Content -->
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose prose-lg dark:prose-invert max-w-none">

        <!-- Introduction -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Introduction</h2>
          <p class="text-gray-700 dark:text-gray-300">
            Welcome to Mint Prints. These Terms and Conditions ("Terms") govern your use of our website and services. By accessing our website at <a href="https://mintprints.im" class="text-mint hover:underline">mintprints.im</a> or using our services, you agree to be bound by these Terms. If you do not agree with any part of these Terms, please do not use our website or services.
          </p>
        </div>

        <!-- Services -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Services</h2>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Mint Prints provides the following services:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>FDM (Fused Deposition Modeling) 3D printing</li>
            <li>SLA (Stereolithography) resin 3D printing</li>
            <li>Laser cutting and etching</li>
            <li>Custom design services</li>
            <li>Prototyping and production services</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300">
            All services are subject to availability and our acceptance of your order.
          </p>
        </div>

        <!-- Orders and Quotes -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Orders and Quotes</h2>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Requesting a Quote</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            To request a quote, you must provide:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Project description and specifications</li>
            <li>Design files (if applicable)</li>
            <li>Quantity required</li>
            <li>Delivery requirements</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Quote Validity</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            All quotes are valid for 30 days from the date of issue unless otherwise stated. Prices may be subject to change after this period.
          </p>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Order Acceptance</h3>
          <p class="text-gray-700 dark:text-gray-300">
            An order is only considered accepted when we send you written confirmation (email). We reserve the right to refuse any order at our discretion.
          </p>
        </div>

        <!-- Payment Terms -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Payment Terms</h2>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            We accept the following payment methods:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Bank transfer</li>
            <li>PayPal</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            <strong>Payment Schedule:</strong>
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>For orders under £100: Full payment required before production begins</li>
            <li>For orders over £100: 50% deposit required, with the balance due before delivery/collection</li>
            <li>For custom design projects: Payment terms will be agreed upon individually</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300">
            Late payments may result in delayed delivery. Orders will not be released until payment is received in full.
          </p>
        </div>

        <!-- Design Files and Intellectual Property -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Design Files and Intellectual Property</h2>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Your Files</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            When you provide design files to us, you confirm that:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>You own the intellectual property rights or have permission to use the designs</li>
            <li>The designs do not infringe on any third-party intellectual property rights</li>
            <li>You grant us a license to use the files solely for the purpose of fulfilling your order</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Custom Designs We Create</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            For custom design work:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Once full payment is received, you own the rights to the final design</li>
            <li>We retain the right to showcase the work in our portfolio unless you request otherwise</li>
            <li>We may retain design files for future orders or modifications</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Prohibited Content</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            We reserve the right to refuse to print or produce:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Items that infringe intellectual property rights</li>
            <li>Weapons or items intended to cause harm</li>
            <li>Illegal or offensive content</li>
            <li>Items that could be used to commit fraud or deception</li>
          </ul>
        </div>

        <!-- Production and Delivery -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Production and Delivery</h2>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Production Times</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Production times are estimates only and may vary depending on:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Current workload</li>
            <li>Complexity of the project</li>
            <li>Material availability</li>
            <li>Technical difficulties</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            We will keep you informed of any delays.
          </p>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Delivery</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            We offer:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Local delivery on the Isle of Man (charges may apply)</li>
            <li>International shipping to most countries (excluding USA at this time)</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300">
            Delivery costs will be included in your quote. Risk passes to you upon delivery. We are not responsible for items lost or damaged in transit unless caused by our negligence.
          </p>
        </div>

        <!-- Quality and Tolerances -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Quality and Tolerances</h2>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">3D Printing</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            3D printed items may have:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Visible layer lines (standard in FDM printing)</li>
            <li>Minor surface imperfections</li>
            <li>Slight dimensional variations (typically ±0.5mm for FDM, ±0.2mm for SLA)</li>
            <li>Support marks that may require removal or finishing</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Laser Cutting/Etching</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Laser cut/etched items may have:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Slight charring on cut edges (normal for wood and some materials)</li>
            <li>Minor dimensional variations (±0.5mm)</li>
            <li>Natural material variations (grain, color, texture)</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Prototypes and Samples</h3>
          <p class="text-gray-700 dark:text-gray-300">
            We recommend ordering a prototype or sample before committing to large production runs. We are not liable for design issues discovered after production begins.
          </p>
        </div>

        <!-- Returns, Refunds, and Cancellations -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Returns, Refunds, and Cancellations</h2>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Custom Orders</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            As all our work is custom-made to order:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>We do not offer refunds for change of mind</li>
            <li>Orders cannot be cancelled once production has begun</li>
            <li>Deposits are non-refundable once work has commenced</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Defective Items</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            If your item is defective or does not meet the agreed specifications:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Contact us within 7 days of receipt</li>
            <li>Provide photos showing the defect</li>
            <li>We will offer a replacement, repair, or refund at our discretion</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 mt-6">Our Error</h3>
          <p class="text-gray-700 dark:text-gray-300">
            If we make an error in production, we will replace the item at no cost to you.
          </p>
        </div>

        <!-- Limitation of Liability -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Limitation of Liability</h2>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            To the fullest extent permitted by law:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>We are not liable for any indirect, consequential, or special damages</li>
            <li>Our total liability is limited to the amount you paid for the specific order</li>
            <li>We are not responsible for delays caused by circumstances beyond our reasonable control</li>
            <li>We are not liable for any use of items produced by us</li>
          </ul>
        </div>

        <!-- Your Responsibilities -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Your Responsibilities</h2>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            You agree to:
          </p>
          <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-2 mb-4 ml-4">
            <li>Provide accurate and complete information</li>
            <li>Supply appropriate design files and specifications</li>
            <li>Respond promptly to any queries during production</li>
            <li>Approve designs/proofs before production (if applicable)</li>
            <li>Make payment according to the agreed terms</li>
            <li>Collect or arrange collection of completed items in a timely manner</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300">
            Items not collected within 30 days of completion notification may be disposed of, with no refund.
          </p>
        </div>

        <!-- Privacy -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Privacy</h2>
          <p class="text-gray-700 dark:text-gray-300">
            Your use of our services is also governed by our <a href="/privacy" class="text-mint hover:underline">Privacy Policy</a>. Please review it to understand how we collect, use, and protect your personal information.
          </p>
        </div>

        <!-- Changes to Terms -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Changes to These Terms</h2>
          <p class="text-gray-700 dark:text-gray-300">
            We reserve the right to modify these Terms at any time. Changes will be effective immediately upon posting to our website. Your continued use of our services after changes are posted constitutes your acceptance of the revised Terms.
          </p>
        </div>

        <!-- Contact -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Contact Us</h2>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            If you have any questions about these Terms and Conditions, please contact us:
          </p>
          <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
            <p class="text-gray-700 dark:text-gray-300 mb-2">
              <strong class="text-gray-900 dark:text-white">Email:</strong> <a href="mailto:info@mintprints.im" class="text-mint hover:underline">info@mintprints.im</a>
            </p>
            <p class="text-gray-700 dark:text-gray-300 mb-2">
              <strong class="text-gray-900 dark:text-white">Website:</strong> <a href="https://mintprints.im" class="text-mint hover:underline">mintprints.im</a>
            </p>
            <p class="text-gray-700 dark:text-gray-300">
              <strong class="text-gray-900 dark:text-white">Location:</strong> Isle of Man
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
