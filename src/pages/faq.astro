---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    category: "General Questions",
    questions: [
      {
        q: "What services do you offer?",
        a: "We offer FDM (plastic) 3D printing, SLA (resin) 3D printing, laser cutting and etching, and custom design services. We can handle everything from prototyping to finished products."
      },
      {
        q: "Where are you located?",
        a: "We're based on the Isle of Man and serve customers locally and internationally."
      },
      {
        q: "How do I get a quote?",
        a: "Contact us through our contact form or email us directly with details about your project, including any files or design ideas. We'll get back to you with a quote within 1-2 business days."
      }
    ]
  },
  {
    category: "3D Printing",
    questions: [
      {
        q: "What's the difference between FDM and SLA printing?",
        a: "FDM (Fused Deposition Modeling) uses thermoplastic filaments and is great for functional parts, prototypes, and larger objects. SLA (Stereolithography) uses liquid resin cured by UV light, producing incredibly detailed prints perfect for miniatures, jewelry, and intricate designs."
      },
      {
        q: "What materials do you offer?",
        a: "For FDM printing, we offer PLA, PETG, ASA, and TPU. For SLA printing, we use various resins depending on your needs. Contact us to discuss which material is best for your project."
      },
      {
        q: "What file formats do you accept?",
        a: "We accept STL, OBJ, and 3MF files for 3D printing. If you have a different format or need help preparing your files, get in touch and we'll assist you."
      },
      {
        q: "What's the maximum print size?",
        a: "Our Bambu Lab X1C printers can handle prints up to 256 x 256 x 256mm. For larger projects, we can split designs into multiple parts."
      },
      {
        q: "How long does a 3D print take?",
        a: "Print times vary based on size, complexity, and material. Small items may take a few hours, while larger or more detailed prints can take several days. We'll give you an estimated timeline with your quote."
      }
    ]
  },
  {
    category: "Laser Cutting & Etching",
    questions: [
      {
        q: "What materials can you laser cut or etch?",
        a: "Our Omtech 80W CO2 laser can work with wood, acrylic (perspex), glass, slate, leather, and certain plastics. We cannot cut metal, but we can etch it. Contact us if you're unsure about your material."
      },
      {
        q: "What's the maximum cutting size?",
        a: "Our laser bed is 700x500mm, allowing us to work on fairly large projects."
      },
      {
        q: "Can you personalize items I already own?",
        a: "Yes! We can laser etch your existing items like glassware, wooden signs, or leather goods. Just bring them in or contact us to discuss."
      }
    ]
  },
  {
    category: "Design Services",
    questions: [
      {
        q: "I don't have a design - can you help?",
        a: "Absolutely! We offer custom design services. Tell us your idea, and we'll work with you to bring it to life."
      },
      {
        q: "Do you offer design modifications?",
        a: "Yes, we can modify existing designs to suit your needs. This might include resizing, adding text, or making structural changes."
      },
      {
        q: "Can I see a preview before printing?",
        a: "Yes, we'll provide digital previews or mockups of custom designs before production begins."
      }
    ]
  },
  {
    category: "Ordering & Delivery",
    questions: [
      {
        q: "How do I place an order?",
        a: "Contact us through our contact form or email us directly with your project details, including any files or design ideas. We'll get back to you with a quote within 1-2 business days."
      },
      {
        q: "What payment methods do you accept?",
        a: "We accept bank transfers and PayPal. Payment details will be provided with your quote."
      },
      {
        q: "Do you offer delivery?",
        a: "Yes, we can arrange delivery on the Isle of Man or ship internationally to most countries. Delivery costs will be included in your quote."
      },
      {
        q: "Do you ship to the USA?",
        a: "Unfortunately, we are currently unable to deliver to the USA due to post office restrictions at this time. We apologize for any inconvenience."
      },
      {
        q: "What if I'm not happy with my order?",
        a: "Customer satisfaction is our priority. If there's an issue with your order, contact us immediately and we'll work to resolve it."
      }
    ]
  },
  {
    category: "Technical Questions",
    questions: [
      {
        q: "Can you print in multiple colours?",
        a: "Our Bambu Lab X1C printers support multi-colour printing with an Automatic Material System (AMS). Contact us to discuss your multi-colour project."
      },
      {
        q: "What's the layer height/resolution?",
        a: "For FDM printing, we typically print at 0.2mm layer height but can go as fine as 0.08mm for detailed work. Our SLA printers achieve even finer detail with 0.05mm layers."
      },
      {
        q: "Are the prints waterproof?",
        a: "FDM prints are water-resistant but not fully waterproof due to layer lines. We can apply sealants for waterproofing if needed. Resin prints are naturally more water-resistant."
      },
      {
        q: "Can you print functional parts?",
        a: "Yes! We regularly print functional parts, mechanical components, and replacement parts. Materials like PETG and ASA are great for durable, functional prints."
      }
    ]
  }
];
---

<Layout title="FAQ - Frequently Asked Questions">
  <section class="section-tight">
    <div class="site-container">
      <div class="max-w-4xl">
        <p class="eyebrow">FAQ</p>
        <h1 class="page-title mt-4">Answers before you ask.</h1>
        <p class="lede mt-6">
          Common questions about 3D printing, laser cutting, design work, ordering, files, and delivery.
        </p>
      </div>

      <div class="mt-12 space-y-12">
        {faqs.map(category => (
          <section>
            <h2 class="technical-label mb-5">{category.category}</h2>
            <div class="space-y-3">
              {category.questions.map(faq => (
                <details class="faq-item">
                  <summary>{faq.q}</summary>
                  <p class="faq-item__answer">{faq.a}</p>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="site-container">
      <div class="surface-invert corner-frame px-6 py-10 text-center md:px-10 md:py-14">
        <p class="eyebrow !text-[#58b368]">Still unsure?</p>
        <h2 class="section-title mt-4">Ask about your specific project.</h2>
        <p class="lede mx-auto mt-5 !text-[#f4f4ee]/70">
          Send the file, material, dimensions, or idea and we will point you in the right direction.
        </p>
        <a href="/contact/" class="button button-primary mt-8 !border-[#f4f4ee] !bg-[#f4f4ee] !text-[#171917] hover:!border-[#58b368] hover:!bg-[#58b368]">
          Contact us
        </a>
      </div>
    </div>
  </section>
</Layout>
