---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Mint Prints for your 3D printing and laser cutting needs">
  <section class="section-tight">
    <div class="site-container">
      <div class="max-w-4xl">
        <p class="eyebrow">Contact</p>
        <h1 class="page-title mt-4">Tell us what you want to make.</h1>
        <p class="lede mt-6">
          Send a file, a sketch, a reference image, or a rough idea. We will come back with the best process, material, and quote.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
        <!-- Project brief form -->
        <div class="panel corner-frame p-6 md:p-8">
          <div class="mb-8 flex items-start justify-between gap-6">
            <div>
              <p class="technical-label">Project brief</p>
              <h2 class="mt-2 text-2xl font-extrabold tracking-[-0.03em]">Send the details</h2>
            </div>
            <span class="hidden border border-[#58b368]/40 px-3 py-2 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-[#2f6f3d] dark:text-[#58b368] md:inline-block">
              Reply in 1–2 days
            </span>
          </div>

          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/thank-you/"
            enctype="multipart/form-data"
            class="space-y-6"
            id="contact-form"
          >
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="form-timestamp" id="form-timestamp" value="" />

            <!-- Honeypot fields - hidden from real users -->
            <div style="position: absolute; left: -5000px;" aria-hidden="true">
              <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              <input type="text" name="website" tabindex="-1" autocomplete="off" placeholder="Your website" />
              <input type="email" name="confirm-email" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="form-label">Your name</label>
                <input type="text" id="name" name="name" required class="form-field" placeholder="John Smith" />
              </div>

              <div>
                <label for="email" class="form-label">Your email</label>
                <input type="email" id="email" name="email" required class="form-field" placeholder="john@example.com" />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="service" class="form-label">Service</label>
                <select id="service" name="service" class="form-field" required>
                  <option value="">Choose a service</option>
                  <option>FDM plastic printing</option>
                  <option>SLA resin printing</option>
                  <option>Laser cutting or etching</option>
                  <option>Custom design</option>
                  <option>Not sure yet</option>
                </select>
              </div>

              <div>
                <label for="material" class="form-label">Material preference</label>
                <input type="text" id="material" name="material" class="form-field" placeholder="PLA, resin, wood, slate..." />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="quantity" class="form-label">Quantity</label>
                <input type="text" id="quantity" name="quantity" class="form-field" placeholder="1, 10, batch..." />
              </div>

              <div>
                <label for="deadline" class="form-label">Needed by</label>
                <input type="date" id="deadline" name="deadline" class="form-field" />
              </div>
            </div>

            <div>
              <label for="message" class="form-label">Project notes</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="form-field resize-y"
                placeholder="Tell us about the size, use, finish, colours, or anything else useful..."
              ></textarea>
            </div>

            <div>
              <label for="file-upload" class="form-label">Attach files</label>
              <input
                type="file"
                id="file-upload"
                name="file-upload"
                multiple
                accept=".stl,.obj,.3mf,.step,.stp,.gcode,.lbrn,.lbrn2,.svg,.dxf,.pdf,.zip"
                class="form-field file:mr-4 file:border-0 file:bg-[#dff0e2] file:px-4 file:py-2 file:text-sm file:font-bold file:text-[#2f6f3d] dark:file:bg-[#58b368]/15 dark:file:text-[#58b368]"
              />
              <p class="mt-2 text-xs leading-5 text-[#6e7470] dark:text-[#aab1aa]">
                Accepted: STL, OBJ, 3MF, STEP, GCODE, LBRN, LBRN2, SVG, DXF, PDF, ZIP. Max 10MB per file.
              </p>
            </div>

            <!-- Human Verification Checkbox -->
            <div class="flex items-start gap-3 border border-[#d7dbd3] bg-[#f4f4ee]/70 p-4 dark:border-[#f4f4ee]/12 dark:bg-[#f4f4ee]/5">
              <input
                type="checkbox"
                id="human-check"
                name="human-check"
                required
                class="mt-1 h-5 w-5 cursor-pointer rounded border-[#d7dbd3] text-[#58b368] focus:ring-[#58b368]"
              />
              <label for="human-check" class="cursor-pointer select-none text-sm text-[#4c524e] dark:text-[#c3c9c2]">
                <span class="font-bold text-[#1f211f] dark:text-[#f4f4ee]">I am not a robot</span>
                <span class="mt-1 block text-xs">Please check this box to verify you're human.</span>
              </label>
            </div>

            <button type="submit" class="button button-primary w-full">
              Send project brief
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4-4 4M3 12h18" />
              </svg>
            </button>
          </form>
        </div>

        <!-- Side information -->
        <aside class="space-y-4">
          <div class="panel corner-frame p-6 md:p-7">
            <p class="technical-label">Useful details</p>
            <ul class="mt-5 space-y-4 text-sm leading-6 text-[#4c524e] dark:text-[#c3c9c2]">
              <li class="border-l-2 border-[#58b368] pl-4">Dimensions or intended size</li>
              <li class="border-l-2 border-[#58b368] pl-4">Quantity and deadline</li>
              <li class="border-l-2 border-[#58b368] pl-4">Material, colour, or finish preference</li>
              <li class="border-l-2 border-[#58b368] pl-4">Whether the part is decorative or functional</li>
            </ul>
          </div>

          <div class="panel p-6 md:p-7">
            <p class="technical-label">Direct contact</p>
            <div class="mt-5 space-y-4">
              <a href="mailto:info@mintprints.im" class="block text-xl font-extrabold tracking-[-0.03em] text-[#1f211f] hover:text-[#2f6f3d] dark:text-[#f4f4ee] dark:hover:text-[#58b368]">
                info@mintprints.im
              </a>
              <div class="grid gap-2 text-sm font-semibold">
                <a class="footer-link !text-[#2f6f3d] dark:!text-[#58b368]" href="https://www.instagram.com/mintprintsiom/" target="_blank" rel="noopener">Instagram · @mintprintsiom</a>
                <a class="footer-link !text-[#2f6f3d] dark:!text-[#58b368]" href="https://www.facebook.com/mintprintsiom" target="_blank" rel="noopener">Facebook · Mint Prints IOM</a>
              </div>
            </div>
          </div>

          <div class="panel p-6 md:p-7">
            <p class="technical-label">Ready-made products</p>
            <div class="mt-5 grid gap-3">
              <a href="https://www.etsy.com/shop/MintPrintsIOM" target="_blank" rel="noopener" class="button button-secondary justify-between">
                Shop Etsy
                <span aria-hidden="true">↗</span>
              </a>
              <a href="https://www.redbubble.com/people/manxcraft/shop" target="_blank" rel="noopener" class="button button-secondary justify-between">
                Shop Redbubble
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Compiled once at load time, not on every submit
  const SPAM_PATTERNS = [
    /\b(viagra|cialis|casino|poker)\b/,
    /https?:\/\/[^\s]{50,}/,
    /<script/i,
    /\[url=/i,
    /\[link=/i
  ];

  const PROFANITY_PATTERNS = [
    /\bf+u+c+k+/i,
    /\bs+h+i+t+/i,
    /\bb+i+t+c+h+/i,
    /\ba+s+s+h+o+l+e+/i,
    /\bc+u+n+t+/i,
    /\bd+a+m+n+/i,
    /\bh+e+l+l+/i,
    /\bc+r+a+p+/i,
    /\bb+a+s+t+a+r+d+/i,
    /\bd+i+c+k+/i,
    /\bp+i+s+s+/i,
    /\ba+r+s+e+/i,
    /\bb+u+g+g+e+r+/i,
    /\bb+o+l+l+o+c+k+s+/i
  ];

  // Anti-spam protection
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const timestampField = document.getElementById('form-timestamp');

    if (!form || !timestampField) return;

    // Record when the page loaded
    const pageLoadTime = Date.now();
    timestampField.value = pageLoadTime.toString();

    // Form submission handler
    form.addEventListener('submit', (e) => {
      const currentTime = Date.now();
      const timeTaken = (currentTime - pageLoadTime) / 1000; // seconds

      // Check if form was filled too quickly (less than 3 seconds)
      if (timeTaken < 3) {
        e.preventDefault();
        alert('Please take your time filling out the form.');
        return false;
      }

      // Check file upload size (max 10MB per file)
      const fileInput = form.querySelector('input[name="file-upload"]');
      if (fileInput && fileInput.files.length > 0) {
        const maxSize = 10 * 1024 * 1024; // 10MB in bytes
        for (let i = 0; i < fileInput.files.length; i++) {
          if (fileInput.files[i].size > maxSize) {
            e.preventDefault();
            alert(`File "${fileInput.files[i].name}" is too large. Maximum file size is 10MB.`);
            return false;
          }
        }
      }

      // Check if human verification checkbox is checked
      const humanCheck = form.querySelector('input[name="human-check"]');
      if (humanCheck && !humanCheck.checked) {
        e.preventDefault();
        alert('Please confirm that you are not a robot.');
        return false;
      }

      // Check honeypot fields
      const botField = form.querySelector('input[name="bot-field"]');
      const websiteField = form.querySelector('input[name="website"]');
      const confirmEmailField = form.querySelector('input[name="confirm-email"]');

      if ((botField && botField.value) ||
          (websiteField && websiteField.value) ||
          (confirmEmailField && confirmEmailField.value)) {
        e.preventDefault();
        return false;
      }

      // Check for suspicious patterns and profanity in message
      const messageField = form.querySelector('textarea[name="message"]');
      const nameField = form.querySelector('input[name="name"]');

      if (messageField && messageField.value) {
        const message = messageField.value.toLowerCase();

        // Check spam patterns
        for (const pattern of SPAM_PATTERNS) {
          if (pattern.test(message)) {
            e.preventDefault();
            alert('Your message contains suspicious content. Please remove any inappropriate links or text.');
            return false;
          }
        }

        // Check profanity
        for (const pattern of PROFANITY_PATTERNS) {
          if (pattern.test(message)) {
            e.preventDefault();
            alert('Please keep your message professional and free from inappropriate language.');
            return false;
          }
        }
      }

      // Also check name field for profanity
      if (nameField && nameField.value) {
        const name = nameField.value.toLowerCase();
        for (const pattern of PROFANITY_PATTERNS) {
          if (pattern.test(name)) {
            e.preventDefault();
            alert('Please enter a valid name.');
            return false;
          }
        }
      }
    });
  });
</script>
