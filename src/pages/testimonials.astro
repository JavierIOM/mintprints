---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Testimonials" description="See what our customers are saying about Mint Prints">
  <section class="section-tight">
    <div class="site-container">
      <div class="max-w-4xl">
        <p class="eyebrow">Reviews</p>
        <h1 class="page-title mt-4">Trusted for the finish as much as the making.</h1>
        <p class="lede mt-6">
          Customer feedback for Mint Prints is hosted on Trustpilot, where reviews are verified and publicly visible.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="surface-invert corner-frame p-6 md:p-8">
          <div class="flex items-center gap-3">
            <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="#00B67A"/>
            </svg>
            <div>
              <p class="text-2xl font-extrabold tracking-[-0.03em] text-[#00B67A]">Trustpilot</p>
              <p class="technical-label mt-1 !text-[#f4f4ee]/60">Verified customer reviews</p>
            </div>
          </div>
          <div class="mt-8 space-y-4">
            <div class="flex gap-1 text-[#00B67A]" aria-label="Five star rating">
              {Array.from({ length: 5 }).map(() => (
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <p class="text-lg font-bold">Rated Excellent on Trustpilot</p>
            <p class="text-[#f4f4ee]/68">
              Read customer feedback directly on the review platform.
            </p>
          </div>
        </div>

        <div class="panel corner-frame flex flex-col justify-between p-6 md:p-8">
          <div>
            <p class="technical-label">Customer feedback</p>
            <h2 class="section-title mt-4 !text-[clamp(2rem,4vw,3.5rem)]">See what people say after the job is done.</h2>
            <p class="lede mt-5">
              Reviews cover finished print quality, communication, turnaround, and how well the final piece matched the request.
            </p>
          </div>
          <a
            href="https://uk.trustpilot.com/review/mintprints.im"
            target="_blank"
            rel="noopener"
            class="button button-primary mt-8 self-start"
          >
            Read reviews on Trustpilot
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="site-container">
      <div class="surface-invert corner-frame px-6 py-10 text-center md:px-10 md:py-14">
        <p class="eyebrow !text-[#58b368]">Had a good experience?</p>
        <h2 class="section-title mt-4">Your project could be next.</h2>
        <p class="lede mx-auto mt-5 !text-[#f4f4ee]/70">
          Send the details and we will help you choose the right process from the start.
        </p>
        <a href="/contact/" class="button button-primary mt-8 !border-[#f4f4ee] !bg-[#f4f4ee] !text-[#171917] hover:!border-[#58b368] hover:!bg-[#58b368]">
          Get in touch
        </a>
      </div>
    </div>
  </section>
</Layout>
