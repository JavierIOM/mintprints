---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Testimonials" description="See what our customers are saying about Mint Prints">
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Testimonials</h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          What our customers are saying
        </p>
        <p class="text-gray-500 dark:text-gray-400 mt-2">
          Genuine feedback from satisfied customers
        </p>
      </div>

      <!-- Trust Message -->
      <div class="bg-gradient-to-br from-mint/5 to-mint/10 dark:from-mint/10 dark:to-mint/5 rounded-2xl p-8 mb-12 text-center">
        <div class="w-16 h-16 bg-mint/20 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="text-lg text-gray-700 dark:text-gray-200 max-w-2xl mx-auto">
          We pride ourselves on the quality of our work and products. Hear directly from those who have experienced the difference!
        </p>
      </div>

      <!-- Trustpilot Widget -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-700">
        <!-- TrustBox widget - Carousel -->
        <div class="trustpilot-widget" data-locale="en-GB" data-template-id="53aa8912dec7e10d38f59f36" data-businessunit-id="6764b51e9b7ec0ff2e4fb5c5" data-style-height="140px" data-style-width="100%" data-theme="light" data-stars="1,2,3,4,5" data-review-languages="en">
          <a href="https://uk.trustpilot.com/review/mintprints.im" target="_blank" rel="noopener">Trustpilot</a>
        </div>

        <div class="mt-6 text-center">
          <a
            href="https://uk.trustpilot.com/review/mintprints.im"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-6 py-3 bg-[#00B67A] text-white font-semibold rounded-xl hover:bg-[#009567] transition-colors text-sm"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            Read All Reviews on Trustpilot
          </a>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          Had a great experience? We'd love to hear from you!
        </p>
        <a href="/contact/" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-white font-semibold rounded-xl hover:bg-mint-dark transition-colors">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>

<!-- Trustpilot Bootstrap Script -->
<script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
