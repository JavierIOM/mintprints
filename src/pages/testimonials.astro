---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Testimonials" description="See what our customers are saying about Mint Prints">
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="mb-12 max-w-2xl">
        <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">Testimonials</h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          We pride ourselves on the quality of our work. Here's what customers say about it.
        </p>
      </div>

      <!-- Trustpilot Section -->
      <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 border border-gray-200 dark:border-gray-800">
        <div class="text-center">
          <!-- Trustpilot Logo and Branding -->
          <div class="flex items-center justify-center gap-3 mb-6">
            <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="#00B67A"/>
            </svg>
            <span class="text-4xl font-bold text-[#00B67A]">Trustpilot</span>
          </div>

          <p class="text-lg text-gray-700 dark:text-gray-200 mb-6">
            See what our customers are saying about us
          </p>

          <!-- Review Stats Placeholder -->
          <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-6 mb-6">
            <div class="flex items-center justify-center gap-2 mb-3">
              <svg class="w-8 h-8 text-[#00B67A]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <svg class="w-8 h-8 text-[#00B67A]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <svg class="w-8 h-8 text-[#00B67A]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <svg class="w-8 h-8 text-[#00B67A]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <svg class="w-8 h-8 text-[#00B67A]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              Rated <span class="font-semibold">Excellent</span> on Trustpilot
            </p>
          </div>

          <a
            href="https://uk.trustpilot.com/review/mintprints.im"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-8 py-4 bg-[#00B67A] text-white font-semibold rounded-xl hover:bg-[#009567] transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            Read Our Reviews on Trustpilot
          </a>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          Had a great experience? We'd love to hear from you.
        </p>
        <a href="/contact/" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-gray-900 font-semibold rounded-xl hover:bg-mint-light active:scale-[0.98] transition">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>
