---
import Layout from '../layouts/Layout.astro';

const ELFSIGHT_WIDGET_ID = "417e8f39-9ae2-4899-b619-01cdf8d5970e";
---

<Layout title="Gallery" description="Browse through our previous 3D printing and laser cutting projects">
  <section class="section-tight">
    <div class="site-container">
      <div class="max-w-4xl">
        <p class="eyebrow">Gallery</p>
        <h1 class="page-title mt-4">Finished work, real materials.</h1>
        <p class="lede mt-6">
          Browse previous 3D prints, laser-etched pieces, personalised gifts, and workshop projects. For the latest work, follow Mint Prints on Instagram.
        </p>
      </div>

      <div class="panel corner-frame mt-12 p-4 md:p-8">
        {ELFSIGHT_WIDGET_ID ? (
          <!-- Elfsight Instagram Feed Widget -->
          <div class={`elfsight-app-${ELFSIGHT_WIDGET_ID}`} data-elfsight-app-lazy></div>
        ) : (
          <!-- Fallback when widget not configured -->
          <div class="py-16 text-center">
            <p class="eyebrow">Instagram feed</p>
            <h2 class="section-title mt-4">The live gallery is being set up.</h2>
            <p class="lede mx-auto mt-5">
              In the meantime, the latest project photos are posted to Instagram.
            </p>
            <a
              href="https://www.instagram.com/mintprintsiom/"
              target="_blank"
              rel="noopener"
              class="button button-primary mt-8"
            >
              Follow @mintprintsiom
            </a>
          </div>
        )}
      </div>

      <div class="surface-invert corner-frame mt-8 px-6 py-10 text-center md:px-10 md:py-14">
        <p class="eyebrow !text-[#58b368]">Inspired?</p>
        <h2 class="section-title mt-4">Let’s make the next piece yours.</h2>
        <p class="lede mx-auto mt-5 !text-[#f4f4ee]/70">
          Bring a reference, a file, or a rough idea. We will recommend the best process and quote it properly.
        </p>
        <a href="/contact/" class="button button-primary mt-8 !border-[#f4f4ee] !bg-[#f4f4ee] !text-[#171917] hover:!border-[#58b368] hover:!bg-[#58b368]">
          Start your project
        </a>
      </div>
    </div>
  </section>
</Layout>

<!-- Elfsight Platform Script - only loads if widget ID is set -->
{ELFSIGHT_WIDGET_ID && (
  <script src="https://elfsightcdn.com/platform.js" async></script>
)}
