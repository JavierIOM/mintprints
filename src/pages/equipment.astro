---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import laserWork from '../assets/images/hero/hero-1.jpg';
import fdmWork from '../assets/images/hero/hero-5.jpg';
---

<Layout title="What We Use" description="Discover the professional equipment and technology behind Mint Prints">
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 max-w-2xl">
        <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">What We Use</h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          The machines behind the work, and what each one is best at.
        </p>
      </div>

      <div class="space-y-8">
        <!-- Omtech Laser -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 border border-gray-200 dark:border-gray-800">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-mint/10 rounded-lg mb-4">
                <svg class="w-5 h-5 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span class="text-sm font-semibold text-mint">Laser Cutting & Etching</span>
              </div>
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Omtech 80W CO2 Laser</h2>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Our 80W CO2 laser cutter (100W peak) delivers precision cutting and engraving on a wide range of materials.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">700mm × 500mm bed:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Large working area for bigger projects</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">80W continuous / 100W peak:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Cuts through thick materials with ease</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">Materials:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Wood, acrylic, leather, fabric, cardboard, and more</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">Precision:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Intricate designs and fine details</span>
                  </div>
                </li>
              </ul>
            </div>
            <div class="rounded-xl overflow-hidden">
              <Image
                src={laserWork}
                alt="Mirror-etched Star Wars artwork cut on our CO2 laser"
                class="w-full h-full object-cover aspect-[4/3]"
              />
            </div>
          </div>
        </div>

        <!-- Bambu Lab X1C -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 border border-gray-200 dark:border-gray-800">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div class="order-2 md:order-1 rounded-xl overflow-hidden">
              <Image
                src={fdmWork}
                alt="Multi-colour Grinch wall art printed on the Bambu Lab X1C"
                class="w-full h-full object-cover aspect-[4/3]"
              />
            </div>
            <div class="order-1 md:order-2">
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-mint/10 rounded-lg mb-4">
                <svg class="w-5 h-5 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                <span class="text-sm font-semibold text-mint">FDM 3D Printing</span>
              </div>
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Bambu Lab X1C Printers</h2>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Industry-leading FDM printers known for exceptional speed, reliability, and print quality. Our dual setup ensures faster turnaround times.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">CoreXY design:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Fast, accurate printing with incredible quality</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">Multi-material AMS:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Print with multiple colours and materials</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">AI monitoring:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Built-in camera and detection for print quality</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">Materials:</span>
                    <span class="text-gray-600 dark:text-gray-300"> PLA, PETG, ABS, TPU, and engineering filaments</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Elegoo Resin Printers -->
        <!-- TODO: add a real resin print photo here (miniature or detailed piece) when one is available -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 border border-gray-200 dark:border-gray-800">
          <div>
            <div>
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-mint/10 rounded-lg mb-4">
                <svg class="w-5 h-5 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
                <span class="text-sm font-semibold text-mint">Resin 3D Printing</span>
              </div>
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Elegoo 5K Resin Printers</h2>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                High-resolution resin printers perfect for detailed miniatures, jewellery, and intricate designs requiring ultra-fine detail.
              </p>
              <ul class="grid sm:grid-cols-2 gap-3">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">5K resolution:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Ultra-detailed prints with smooth surfaces</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">Monochrome LCD:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Faster curing times and longer screen life</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">Perfect for:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Miniatures, jewelry, dental models, and prototypes</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-mint mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <span class="font-semibold text-gray-900 dark:text-white">Materials:</span>
                    <span class="text-gray-600 dark:text-gray-300"> Standard, tough, flexible, and specialty resins</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="mt-12 text-center bg-mint/10 rounded-2xl p-8">
        <h3 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
          Not sure which machine your project needs?
        </h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-2xl mx-auto">
          Tell us what you're after and we'll pick the right process for the job.
        </p>
        <a href="/contact/" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-gray-900 font-semibold rounded-xl hover:bg-mint-light active:scale-[0.98] transition">
          Get a Quote
        </a>
      </div>

      <!-- Redbubble Shop Section -->
      <div class="mt-12 bg-white dark:bg-gray-900 rounded-2xl p-8 border border-gray-200 dark:border-gray-800">
        <div>
          <div>
            <div class="flex items-center gap-3 mb-4">
              <svg class="w-12 h-12 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M16.633 16.324h-3.199a.321.321 0 0 1-.32-.322V7.974a.32.32 0 0 1 .32-.32H16.4c2.226 0 2.693 1.31 2.693 2.408 0 .636-.169 1.14-.504 1.511.816.337 1.256 1.096 1.256 2.194 0 1.601-1.201 2.557-3.212 2.557m-4.644 0H5.345a.32.32 0 0 1-.32-.322V7.974a.32.32 0 0 1 .32-.32h3.103c1.939 0 3.096 1.043 3.096 2.791 0 1.163-.585 2.077-1.527 2.448l2.21 2.897a.322.322 0 0 1-.24.533M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12c6.628 0 12-5.373 12-12S18.63 0 12.001 0"/>
              </svg>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Visit Our Redbubble Shop</h3>
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-2xl">
              Our designs also live on apparel and accessories over on Redbubble, including plenty of Manx-inspired artwork.
            </p>
            <ul class="grid sm:grid-cols-2 gap-3 mb-6">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-mint flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700 dark:text-gray-200">Custom t-shirts and hoodies</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-mint flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700 dark:text-gray-200">Hats and caps with unique designs</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-mint flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700 dark:text-gray-200">Stickers and decals</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-mint flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700 dark:text-gray-200">Mugs, phone cases, and more</span>
              </li>
            </ul>
            <a
              href="https://www.redbubble.com/people/manxcraft/shop"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-xl active:scale-[0.98] transition"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M16.633 16.324h-3.199a.321.321 0 0 1-.32-.322V7.974a.32.32 0 0 1 .32-.32H16.4c2.226 0 2.693 1.31 2.693 2.408 0 .636-.169 1.14-.504 1.511.816.337 1.256 1.096 1.256 2.194 0 1.601-1.201 2.557-3.212 2.557m-4.644 0H5.345a.32.32 0 0 1-.32-.322V7.974a.32.32 0 0 1 .32-.32h3.103c1.939 0 3.096 1.043 3.096 2.791 0 1.163-.585 2.077-1.527 2.448l2.21 2.897a.322.322 0 0 1-.24.533M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12c6.628 0 12-5.373 12-12S18.63 0 12.001 0"/>
              </svg>
              Shop on Redbubble
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
