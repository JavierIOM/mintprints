---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/images/hero/*.jpg', { eager: true });
const machineImage = Object.entries(imageModules)
  .sort(([a], [b]) => {
    const nA = parseInt(a.match(/hero-(\d+)/)?.[1] ?? '0');
    const nB = parseInt(b.match(/hero-(\d+)/)?.[1] ?? '0');
    return nA - nB;
  })
  .map(([, mod]) => mod.default)[22];

const equipment = [
  {
    category: 'Laser cutting & etching',
    title: 'Omtech 80W CO2 Laser',
    description: 'An 80W continuous / 100W peak CO2 laser for precision cutting and detailed engraving across wood, acrylic, glass, slate, leather, and more.',
    specs: [
      ['Workbed', '700 × 500mm'],
      ['Power', '80W continuous / 100W peak'],
      ['Strengths', 'Fine etching, clean cuts, personalisation'],
      ['Materials', 'Wood, acrylic, leather, fabric, cardboard, glass, slate']
    ]
  },
  {
    category: 'FDM 3D printing',
    title: 'Bambu Lab X1C Printers',
    description: 'A dual FDM setup with fast CoreXY motion, multi-material capability, and built-in monitoring for reliable prototype and production work.',
    specs: [
      ['Build volume', '256 × 256 × 256mm per printer'],
      ['Materials', 'PLA, PETG, ASA, TPU, and engineering filaments'],
      ['Colour system', 'Automatic Material System for multi-colour prints'],
      ['Strengths', 'Speed, repeatability, functional parts']
    ]
  },
  {
    category: 'SLA resin printing',
    title: 'Elegoo 5K Resin Printers',
    description: 'High-resolution resin printing for miniatures, jewellery, dental models, and intricate pieces where smooth surfaces and fine details matter.',
    specs: [
      ['Resolution', '5K monochrome LCD'],
      ['Layer detail', 'Fine layers down to 0.05mm'],
      ['Materials', 'Standard, tough, flexible, and specialty resins'],
      ['Strengths', 'Miniatures, jewellery, detailed prototypes']
    ]
  }
];
---

<Layout title="What We Use" description="Discover the professional equipment and technology behind Mint Prints">
  <section class="section-tight">
    <div class="site-container">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">Workshop equipment</p>
          <h1 class="page-title mt-4">Professional machines, practical output.</h1>
          <p class="lede mt-6">
            The setup is built around speed, detail, and repeatability — from functional FDM parts to fine resin models and large-format laser work.
          </p>
        </div>
        <figure class="image-frame corner-frame relative h-72 lg:h-96">
          <Image
            src={machineImage}
            alt="3D printer and workshop equipment at Mint Prints"
            class="h-full w-full object-cover"
            loading="eager"
          />
          <figcaption class="technical-label absolute bottom-3 left-3 bg-[#1f211f]/85 px-3 py-2 text-[#f4f4ee]">
            In the workshop
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section-block border-t border-[#d7dbd3] dark:border-[#f4f4ee]/12">
    <div class="site-container space-y-6">
      {equipment.map((machine, index) => (
        <article class:list={["panel corner-frame grid gap-8 p-6 md:p-8 lg:grid-cols-[0.8fr_1.2fr]", { "lg:[&>*:first-child]:order-2": index === 1 }]}>
          <div>
            <p class="technical-label">{machine.category}</p>
            <h2 class="section-title mt-4 !text-[clamp(2rem,4vw,3.5rem)]">{machine.title}</h2>
            <p class="lede mt-5">{machine.description}</p>
          </div>
          <dl class="spec-table self-center">
            {machine.specs.map(([label, value]) => (
              <div class="spec-row">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="site-container grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-center">
      <div class="surface-invert corner-frame p-6 md:p-10">
        <p class="eyebrow !text-[#58b368]">Project ready?</p>
        <h2 class="section-title mt-4">Put the workshop to work.</h2>
        <p class="lede mt-5 !text-[#f4f4ee]/70">
          Send the project details and we will match it to the right machine, material, and finish.
        </p>
        <a href="/contact/" class="button button-primary mt-8 !border-[#f4f4ee] !bg-[#f4f4ee] !text-[#171917] hover:!border-[#58b368] hover:!bg-[#58b368]">
          Get a quote
        </a>
      </div>

      <div class="panel p-6 md:p-8">
        <p class="technical-label">Also available</p>
        <h2 class="mt-4 text-3xl font-extrabold tracking-[-0.04em]">Redbubble shop</h2>
        <p class="mt-4 leading-7 text-[#4c524e] dark:text-[#c3c9c2]">
          Browse Isle of Man-inspired apparel, accessories, stickers, mugs, phone cases, and more through the Redbubble shop.
        </p>
        <a href="https://www.redbubble.com/people/manxcraft/shop" target="_blank" rel="noopener" class="button button-secondary mt-7">
          Visit Redbubble
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
