---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You" description="Your message has been sent successfully">
  <section class="py-20">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <div class="w-20 h-20 bg-mint/20 rounded-full flex items-center justify-center mx-auto mb-8">
        <svg class="w-10 h-10 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">Thank You!</h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
        Your message has been sent. We'll get back to you as soon as possible.
      </p>

      <a href="/" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-gray-900 font-semibold rounded-xl hover:bg-mint-light active:scale-[0.98] transition">
        Back to Home
      </a>
    </div>
  </section>
</Layout>
