---
import Layout from '../layouts/Layout.astro';
import Chatbot from '../components/Chatbot.astro';
import { Image } from 'astro:assets';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/images/hero/*.jpg', { eager: true });
const heroImages = Object.entries(imageModules)
  .sort(([a], [b]) => {
    const nA = parseInt(a.match(/hero-(\d+)/)?.[1] ?? '0');
    const nB = parseInt(b.match(/hero-(\d+)/)?.[1] ?? '0');
    return nA - nB;
  })
  .map(([, mod]) => mod.default);

const laserPhoto = heroImages[9];   // hero-10: laser-cut acrylic TT parts
const fdmPhoto = heroImages[5];     // hero-6: functional FDM part
const marqueeImages = [1, 3, 7, 11, 13, 15, 19, 21, 23, 16].map(i => heroImages[i]);
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="py-16 md:py-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <!-- Text -->
        <div>
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 leading-[1.05]">
            Where all your prints are <span class="text-mint">Mint!</span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-10 max-w-lg">
            3D printing, laser cutting and custom design on the Isle of Man, from one-off prototypes to finished products.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-gray-900 font-semibold rounded-xl hover:bg-mint-light active:scale-[0.98] transition">
              Get in Touch
            </a>
            <a href="/gallery" class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-transparent text-gray-700 dark:text-gray-200 font-semibold rounded-xl border-2 border-gray-200 dark:border-gray-800 hover:border-mint dark:hover:border-mint hover:text-mint active:scale-[0.98] transition">
              View Our Work
            </a>
          </div>
        </div>

        <!-- Images - desktop mosaic -->
        <div class="hidden md:grid grid-cols-2 grid-rows-3 gap-3 h-[520px]">
          <div class="row-span-2 rounded-2xl overflow-hidden">
            <Image
              data-hero-img="0"
              src={heroImages[0]}
              alt="Laser-etched Star Wars acrylic by Mint Prints"
              width={800}
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="rounded-2xl overflow-hidden">
            <Image
              data-hero-img="1"
              src={heroImages[3]}
              alt="3D printed custom accessory by Mint Prints"
              width={600}
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
            />
          </div>
          <div class="rounded-2xl overflow-hidden">
            <Image
              data-hero-img="2"
              src={heroImages[1]}
              alt="Work by Mint Prints"
              width={600}
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
            />
          </div>
          <div class="col-span-2 rounded-2xl overflow-hidden">
            <Image
              data-hero-img="3"
              src={heroImages[2]}
              alt="Work by Mint Prints"
              width={1000}
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
            />
          </div>
        </div>
        <!-- Single image - mobile only -->
        <div class="block md:hidden rounded-2xl overflow-hidden h-72 mt-2">
          <Image
            src={heroImages[0]}
            alt="Work by Mint Prints"
            width={800}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- Services Bento -->
  <section class="py-20 bg-gray-100/70 dark:bg-gray-900/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 max-w-2xl" data-reveal>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">Our Services</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Four ways we can help, all under one roof on the Isle of Man.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-4" data-reveal>
        <!-- Laser: photo cell, wide -->
        <a href="/contact" class="group relative md:col-span-2 rounded-2xl overflow-hidden min-h-[280px] flex items-end">
          <Image
            src={laserPhoto}
            alt="Laser-cut and etched acrylic parts on the workbench"
            width={1200}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/40 to-gray-950/10"></div>
          <div class="relative p-8">
            <h3 class="text-2xl font-semibold text-white mb-2">Laser Cutting & Etching</h3>
            <p class="text-gray-200 max-w-md">80W CO2 laser, 700x500mm bed. Wood, glass, perspex, slate and more.</p>
          </div>
        </a>

        <!-- FDM: photo cell -->
        <a href="/contact" class="group relative rounded-2xl overflow-hidden min-h-[280px] flex items-end">
          <Image
            src={fdmPhoto}
            alt="Functional FDM 3D printed part"
            width={700}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/40 to-gray-950/10"></div>
          <div class="relative p-8">
            <h3 class="text-2xl font-semibold text-white mb-2">FDM Printing</h3>
            <p class="text-gray-200">PLA, PETG, ASA and TPU for models, prototypes and working parts.</p>
          </div>
        </a>

        <!-- SLA: text cell -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 border border-gray-200 dark:border-gray-800 hover:border-mint/60 dark:hover:border-mint/60 transition-colors">
          <div class="w-14 h-14 bg-mint/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">SLA (Resin) Printing</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">Incredibly detailed models using UV laser technology. Ideal for wargamers, miniatures, and anything requiring precision at 30mm scale and beyond.</p>
        </div>

        <!-- Custom Design: text cell, wide -->
        <div class="md:col-span-2 bg-white dark:bg-gray-900 rounded-2xl p-8 border border-gray-200 dark:border-gray-800 hover:border-mint/60 dark:hover:border-mint/60 transition-colors">
          <div class="w-14 h-14 bg-mint/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Custom Design</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">Original artwork and bespoke designs tailored to your needs. Bring us a sketch, a photo or just an idea and we'll take it from concept to finished piece.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Work Marquee -->
  <section class="py-20 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 mb-10 flex items-end justify-between gap-4" data-reveal>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">Recent Work</h2>
      <a href="/gallery" class="text-mint font-semibold hover:text-mint-dark dark:hover:text-mint-light transition-colors whitespace-nowrap">View the gallery</a>
    </div>
    <div class="marquee-track">
      {marqueeImages.map(img => (
        <div class="h-44 md:h-56 aspect-[4/3] rounded-xl overflow-hidden flex-shrink-0">
          <Image src={img} alt="Recent work by Mint Prints" width={520} class="w-full h-full object-cover" />
        </div>
      ))}
      {marqueeImages.map(img => (
        <div class="h-44 md:h-56 aspect-[4/3] rounded-xl overflow-hidden flex-shrink-0" aria-hidden="true">
          <Image src={img} alt="" width={520} class="w-full h-full object-cover" />
        </div>
      ))}
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-gray-100/70 dark:bg-gray-900/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 max-w-2xl" data-reveal>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">How It Works</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8" data-reveal>
        <div class="border-t-2 border-mint/60 pt-6">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Send it over</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">Use the contact form with your files, a photo or just the idea. STL, STEP, SVG, DXF and most common formats are all fine.</p>
        </div>
        <div class="border-t-2 border-mint/60 pt-6">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Get a quote</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">We'll come back within a couple of business days with a price and a realistic timeline. No obligation.</p>
        </div>
        <div class="border-t-2 border-mint/60 pt-6">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">We make it</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">Printed or cut here on the island, checked over, then delivered locally or shipped further afield.</p>
        </div>
      </div>
    </div>
  </section>

  <Chatbot />

  <!-- CTA Section -->
  <section class="py-24 bg-mint">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-5xl md:text-6xl font-bold tracking-tight text-gray-900 mb-6">Ready to start your project?</h2>
      <p class="text-xl text-gray-900 mb-10">
        Send us your idea or your files and we'll come back with a quote.
      </p>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 active:scale-[0.98] transition">
        Get in Touch
      </a>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ imageSrcs: heroImages.map(img => img.src) }}>
  imageSrcs.forEach(src => { new window.Image().src = src; });

  const slots = Array.from(document.querySelectorAll('[data-hero-img]'));
  const current = [0, 3, 5, 1].map(o => o % imageSrcs.length);

  function pickNext() {
    const used = new Set(current);
    const available = imageSrcs.map((_, i) => i).filter(i => !used.has(i));
    return available[Math.floor(Math.random() * available.length)];
  }

  slots.forEach((img, i) => {
    setTimeout(() => {
      setInterval(() => {
        img.style.opacity = '0';
        setTimeout(() => {
          current[i] = pickNext();
          img.src = imageSrcs[current[i]];
          img.style.opacity = '1';
        }, 1500);
      }, 9000);
    }, i * 3000);
  });
</script>
