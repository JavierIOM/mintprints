---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const services = [
  {
    title: "FDM (Plastic) Printing",
    description: "High-quality thermoplastic printing using PLA, PETG, ASA, and TPU. Perfect for modelling, prototyping, and low-volume finished products.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>`
  },
  {
    title: "SLA (Resin) Printing",
    description: "Incredibly detailed models using UV laser technology. Ideal for wargamers, miniatures, and anything requiring precision at 30mm scale and beyond.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`
  },
  {
    title: "Laser Cutting & Etching",
    description: "Precision work with our 80-watt CO2 laser and 700x500mm workbed. Personalise wood, glass, perspex, slate and more with custom designs.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Custom Design",
    description: "Original artwork and bespoke designs tailored to your needs. From concept to creation, we bring your ideas to life.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>`
  }
];
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-gray-50 to-white py-20 md:py-32">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
        Where all your prints are <span class="text-mint">Mint!</span>
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-10">
        Professional 3D printing, laser cutting, and custom design services.
        From prototypes to finished products, we bring your ideas to life.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-white font-semibold rounded-xl hover:bg-mint-dark transition-colors">
          Get in Touch
        </a>
        <a href="/gallery" class="inline-flex items-center justify-center px-8 py-4 bg-white text-gray-700 font-semibold rounded-xl border-2 border-gray-200 hover:border-mint hover:text-mint transition-colors">
          View Our Work
        </a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Our Services</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          From rapid prototyping to bespoke finished products, we offer a range of services to meet your needs.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-mint">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ready to start your project?</h2>
      <p class="text-xl text-white/90 mb-10">
        Get in touch and let's discuss how we can bring your ideas to life.
      </p>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-mint font-semibold rounded-xl hover:bg-gray-100 transition-colors">
        Contact Us Today
      </a>
    </div>
  </section>
</Layout>
