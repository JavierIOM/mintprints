---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Chatbot from '../components/Chatbot.astro';
import { Image } from 'astro:assets';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/images/hero/*.jpg', { eager: true });
const heroImages = Object.entries(imageModules)
  .sort(([a], [b]) => {
    const nA = parseInt(a.match(/hero-(\d+)/)?.[1] ?? '0');
    const nB = parseInt(b.match(/hero-(\d+)/)?.[1] ?? '0');
    return nA - nB;
  })
  .map(([, mod]) => mod.default);

const services = [
  {
    title: "FDM Plastic Printing",
    tag: "Prototype to product",
    description: "High-quality thermoplastic printing in PLA, PETG, ASA, and TPU for models, mechanical parts, replacement components, and low-volume finished products.",
    icon: `<svg class="h-full w-full" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`
  },
  {
    title: "SLA Resin Printing",
    tag: "Fine detail",
    description: "Detailed UV resin prints for miniatures, jewellery, tabletop figures, and intricate designs where clean surfaces and small features matter.",
    icon: `<svg class="h-full w-full" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`
  },
  {
    title: "Laser Cutting & Etching",
    tag: "Personalised finish",
    description: "Precision work on our 80W CO2 laser with a 700 × 500mm bed. Cut or etch wood, glass, perspex, slate, leather, and more.",
    icon: `<svg class="h-full w-full" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Custom Design",
    tag: "Idea to artwork",
    description: "Original artwork, design refinement, resizing, and bespoke project planning. Bring a rough idea or an existing file and we will help shape it.",
    icon: `<svg class="h-full w-full" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`
  }
];

const materials = [
  "PLA",
  "PETG",
  "ASA",
  "TPU",
  "Resin",
  "Wood",
  "Acrylic",
  "Glass",
  "Slate",
  "Leather",
  "Fabric",
  "Custom artwork"
];

const featured = [
  { src: heroImages[0], label: "Laser-etched acrylic", alt: "Detailed laser etched acrylic disc by Mint Prints" },
  { src: heroImages[8], label: "Etched hardwood", alt: "Laser etched hardwood panel by Mint Prints" },
  { src: heroImages[10], label: "Branded coasters", alt: "Set of laser etched branded coasters by Mint Prints" },
  { src: heroImages[23], label: "Functional print", alt: "Blue flexible 3D printed object by Mint Prints" }
];

const specs = [
  ["FDM build volume", "256 × 256 × 256mm"],
  ["Laser bed", "700 × 500mm"],
  ["Resin detail", "Fine layers down to 0.05mm"],
  ["Accepted files", "STL, OBJ, 3MF, STEP, GCODE, LBRN, SVG, DXF, PDF, ZIP"]
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="section-tight overflow-hidden">
    <div class="site-container grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div class="fade-in">
        <p class="eyebrow">Isle of Man · 3D printing · laser · design</p>
        <h1 class="display-title mt-5">
          Custom prints, <span class="text-[#2f6f3d] dark:text-[#58b368]">cut</span> & etched with workshop precision.
        </h1>
        <p class="lede mt-7">
          Professional 3D printing, laser cutting, and custom design on the Isle of Man. From prototypes to finished products, we bring your ideas to life.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/" class="button button-primary">
            Start your project
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4-4 4M3 12h18" />
            </svg>
          </a>
          <a href="/gallery/" class="button button-secondary">View our work</a>
        </div>
        <p class="technical-label mt-7">STL · OBJ · 3MF · STEP · SVG · DXF · PDF</p>
      </div>

      <div class="grid gap-3 md:grid-cols-[1.15fr_0.85fr]">
        <figure class="image-frame corner-frame relative h-[24rem] md:h-[34rem]">
          <Image
            src={featured[0].src}
            alt={featured[0].alt}
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="technical-label absolute bottom-3 left-3 bg-[#1f211f]/85 px-3 py-2 text-[#f4f4ee]">
            {featured[0].label}
          </figcaption>
        </figure>

        <div class="grid grid-cols-2 gap-3 md:grid-cols-1">
          {featured.slice(1).map(item => (
            <figure class="image-frame relative h-40 md:h-[10.65rem]">
              <Image src={item.src} alt={item.alt} class="h-full w-full object-cover" loading="eager" />
              <figcaption class="technical-label absolute bottom-2 left-2 bg-[#1f211f]/85 px-2 py-1 text-[0.62rem] text-[#f4f4ee]">
                {item.label}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Material marquee -->
  <div class="material-strip" aria-label="Materials we work with">
    <div class="material-strip__track">
      {materials.map(material => <span class="material-strip__item">{material}</span>)}
      {materials.map(material => <span class="material-strip__item" aria-hidden="true">{material}</span>)}
    </div>
  </div>

  <!-- Services -->
  <section class="section-block">
    <div class="site-container">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <p class="eyebrow">Services</p>
          <h2 class="section-title mt-4">The right process for the object you need.</h2>
        </div>
        <p class="lede lg:justify-self-end">
          Use FDM for functional plastic parts, resin for fine detail, the laser for personalised materials, and custom design when you need the idea developed from scratch.
        </p>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            tag={service.tag}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="surface-invert section-block">
    <div class="site-container grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow !text-[#58b368]">How it works</p>
        <h2 class="section-title mt-4">A clearer route from file to finished object.</h2>
        <p class="lede mt-6 !text-[#f4f4ee]/70">
          Send what you have — even a rough sketch or a link. We will help choose the process, refine the design if needed, and quote before production starts.
        </p>
      </div>

      <div>
        <article class="process-step">
          <span class="process-step__number">01</span>
          <h3 class="process-step__title">Send the idea</h3>
          <p class="process-step__copy">Upload a 3D file, vector artwork, or describe what you want made.</p>
        </article>
        <article class="process-step">
          <span class="process-step__number">02</span>
          <h3 class="process-step__title">Approve the quote</h3>
          <p class="process-step__copy">We confirm the process, material, finish, price, and production timeline.</p>
        </article>
        <article class="process-step">
          <span class="process-step__number">03</span>
          <h3 class="process-step__title">Print, cut, finish</h3>
          <p class="process-step__copy">Your project is made, checked, packed, and delivered locally or internationally.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section-block">
    <div class="site-container grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="eyebrow">Workshop capability</p>
        <h2 class="section-title mt-4">Built for one-off pieces, batches, and prototypes.</h2>
        <p class="lede mt-6">
          Whether you need a single replacement part, a run of personalised gifts, or a precise prototype, the workshop setup is geared for practical turnaround and repeatable quality.
        </p>
      </div>

      <div class="panel corner-frame p-6 md:p-8">
        <dl class="spec-table">
          {specs.map(([label, value]) => (
            <div class="spec-row">
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section-block border-t border-[#d7dbd3] dark:border-[#f4f4ee]/12">
    <div class="site-container">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">Recent work</p>
          <h2 class="section-title mt-4">Proof sits in the details.</h2>
        </div>
        <a href="/gallery/" class="text-link">
          Open gallery
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4-4 4M3 12h18" />
          </svg>
        </a>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map(item => (
          <a href="/gallery/" class="image-frame group block h-64" aria-label={`View ${item.label} in the gallery`}>
            <Image
              src={item.src}
              alt={item.alt}
              class="h-full w-full object-cover grayscale-[35%] group-hover:grayscale-0"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-block">
    <div class="site-container">
      <div class="surface-invert corner-frame px-6 py-12 text-center md:px-12 md:py-20">
        <p class="eyebrow !text-[#58b368]">Start a project</p>
        <h2 class="display-title mx-auto mt-5 max-w-4xl !text-[clamp(2.7rem,7vw,6.5rem)]">Have a file? Have an idea?</h2>
        <p class="lede mx-auto mt-6 !text-[#f4f4ee]/70">
          Send the details and we will recommend the best process, material, and next step.
        </p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/contact/" class="button button-primary !border-[#f4f4ee] !bg-[#f4f4ee] !text-[#171917] hover:!border-[#58b368] hover:!bg-[#58b368]">
            Get a quote
          </a>
          <a href="mailto:info@mintprints.im" class="button button-secondary !border-[#f4f4ee]/30 !text-[#f4f4ee] hover:!border-[#58b368] hover:!text-[#58b368]">
            Email us
          </a>
        </div>
      </div>
    </div>
  </section>

  <Chatbot />
</Layout>
