---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Chatbot from '../components/Chatbot.astro';

const services = [
  {
    title: "FDM (Plastic) Printing",
    description: "High-quality thermoplastic printing using PLA, PETG, ASA, and TPU. Perfect for modelling, prototyping, and low-volume finished products.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`
  },
  {
    title: "SLA (Resin) Printing",
    description: "Incredibly detailed models using UV laser technology. Ideal for wargamers, miniatures, and anything requiring precision at 30mm scale and beyond.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`
  },
  {
    title: "Laser Cutting & Etching",
    description: "Precision work with our 80-watt CO2 laser and 700x500mm workbed. Personalise wood, glass, perspex, slate and more with custom designs.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Custom Design",
    description: "Original artwork and bespoke designs tailored to your needs. From concept to creation, we bring your ideas to life.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`
  }
];
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-gray-50 to-white dark:from-gray-800 dark:to-gray-900 py-16 md:py-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <!-- Text -->
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
            Where all your prints are <span class="text-mint">Mint!</span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-10 max-w-lg">
            Professional 3D printing, laser cutting, and custom design services on the Isle of Man.
            From prototypes to finished products, we bring your ideas to life.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-white font-semibold rounded-xl hover:bg-mint-dark transition-colors">
              Get in Touch
            </a>
            <a href="/gallery" class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-transparent text-gray-700 dark:text-gray-200 font-semibold rounded-xl border-2 border-gray-200 dark:border-gray-500 hover:border-mint dark:hover:border-current hover:text-mint transition-colors">
              View Our Work
            </a>
          </div>
        </div>

        <!-- Images -->
        <div class="grid grid-cols-2 gap-3 h-[460px]">
          <!-- Tall main image -->
          <div class="row-span-3 rounded-2xl overflow-hidden shadow-lg">
            <img
              data-hero-img="0"
              src="/images/hero/hero-1.jpg"
              alt="Work by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
            />
          </div>
          <!-- Three smaller images stacked -->
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img
              data-hero-img="1"
              src="/images/hero/hero-4.jpg"
              alt="Work by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img
              data-hero-img="2"
              src="/images/hero/hero-2.jpg"
              alt="Work by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img
              data-hero-img="3"
              src="/images/hero/hero-3.jpg"
              alt="Work by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-gray-50 dark:bg-gray-800/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Our Services</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          From rapid prototyping to bespoke finished products, we offer a range of services to meet your needs.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <Chatbot />

  <!-- CTA Section -->
  <section class="py-20 bg-mint">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Ready to start your project?</h2>
      <p class="text-xl text-gray-900/75 mb-10">
        Get in touch and let's discuss how we can bring your ideas to life.
      </p>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-colors">
        Contact Us Today
      </a>
    </div>
  </section>
</Layout>

<script>
  const images = [
    '/images/hero/hero-1.jpg',
    '/images/hero/hero-2.jpg',
    '/images/hero/hero-3.jpg',
    '/images/hero/hero-4.jpg',
    '/images/hero/hero-5.jpg',
    '/images/hero/hero-6.jpg',
    '/images/hero/hero-7.jpg',
  ];

  // Preload all images so swaps are instant
  images.forEach(src => { new Image().src = src; });

  const slots = document.querySelectorAll<HTMLImageElement>('[data-hero-img]');

  // Each slot starts at a different offset so they don't all cycle together
  const startOffsets = [0, 3, 5, 1];

  slots.forEach((img, i) => {
    let current = startOffsets[i] % images.length;

    // Stagger when each slot begins cycling
    setTimeout(() => {
      setInterval(() => {
        img.style.opacity = '0';
        setTimeout(() => {
          current = (current + 1) % images.length;
          img.src = images[current];
          img.style.opacity = '1';
        }, 1500);
      }, 9000);
    }, i * 3000);
  });
</script>
