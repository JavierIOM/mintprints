---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Chatbot from '../components/Chatbot.astro';
import { Image } from 'astro:assets';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/images/hero/*.jpg', { eager: true });
const heroImages = Object.entries(imageModules)
  .sort(([a], [b]) => {
    const nA = parseInt(a.match(/hero-(\d+)/)?.[1] ?? '0');
    const nB = parseInt(b.match(/hero-(\d+)/)?.[1] ?? '0');
    return nA - nB;
  })
  .map(([, mod]) => mod.default);

const services = [
  {
    title: "FDM (Plastic) Printing",
    description: "High-quality thermoplastic printing using PLA, PETG, ASA, and TPU. Perfect for modelling, prototyping, and low-volume finished products.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`
  },
  {
    title: "SLA (Resin) Printing",
    description: "Incredibly detailed models using UV laser technology. Ideal for wargamers, miniatures, and anything requiring precision at 30mm scale and beyond.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`
  },
  {
    title: "Laser Cutting & Etching",
    description: "Precision work with our 80-watt CO2 laser and 700x500mm workbed. Personalise wood, glass, perspex, slate and more with custom designs.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Custom Design",
    description: "Original artwork and bespoke designs tailored to your needs. From concept to creation, we bring your ideas to life.",
    icon: `<svg class="w-8 h-8 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`
  }
];
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="py-16 md:py-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <!-- Text -->
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 leading-tight">
            Where all your prints are <span class="text-mint">Mint!</span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-10 max-w-lg">
            3D printing, laser cutting and custom design on the Isle of Man, from one-off prototypes to finished products.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-mint text-gray-900 font-semibold rounded-xl hover:bg-mint-light active:scale-[0.98] transition">
              Get in Touch
            </a>
            <a href="/gallery" class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-transparent text-gray-700 dark:text-gray-200 font-semibold rounded-xl border-2 border-gray-200 dark:border-gray-500 hover:border-mint dark:hover:border-mint hover:text-mint active:scale-[0.98] transition">
              View Our Work
            </a>
          </div>
        </div>

        <!-- Images - desktop grid -->
        <div class="hidden md:grid grid-cols-2 gap-3 h-[460px]">
          <div class="row-span-3 rounded-2xl overflow-hidden shadow-lg">
            <Image
              data-hero-img="0"
              src={heroImages[0]}
              alt="Laser-etched Star Wars acrylic by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <Image
              data-hero-img="1"
              src={heroImages[3]}
              alt="3D printed custom accessory by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
              loading="eager"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <Image
              data-hero-img="2"
              src={heroImages[1]}
              alt="Work by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <Image
              data-hero-img="3"
              src={heroImages[2]}
              alt="Work by Mint Prints"
              class="w-full h-full object-cover transition-opacity duration-[1500ms]"
            />
          </div>
        </div>
        <!-- Single image - mobile only -->
        <div class="block md:hidden rounded-2xl overflow-hidden shadow-lg h-64 mt-2">
          <Image
            src={heroImages[0]}
            alt="Work by Mint Prints"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-gray-50 dark:bg-gray-800/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-16 max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">Our Services</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Four ways we can help, all under one roof on the Isle of Man.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <Chatbot />

  <!-- CTA Section -->
  <section class="py-20 bg-mint">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-6">Ready to start your project?</h2>
      <p class="text-xl text-gray-900 mb-10">
        Send us your idea or your files and we'll come back with a quote.
      </p>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 active:scale-[0.98] transition">
        Get in Touch
      </a>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ imageSrcs: heroImages.map(img => img.src) }}>
  imageSrcs.forEach(src => { new window.Image().src = src; });

  const slots = Array.from(document.querySelectorAll('[data-hero-img]'));
  const current = [0, 3, 5, 1].map(o => o % imageSrcs.length);

  function pickNext() {
    const used = new Set(current);
    const available = imageSrcs.map((_, i) => i).filter(i => !used.has(i));
    return available[Math.floor(Math.random() * available.length)];
  }

  slots.forEach((img, i) => {
    setTimeout(() => {
      setInterval(() => {
        img.style.opacity = '0';
        setTimeout(() => {
          current[i] = pickNext();
          img.src = imageSrcs[current[i]];
          img.style.opacity = '1';
        }, 1500);
      }, 9000);
    }, i * 3000);
  });
</script>
