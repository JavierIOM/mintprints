---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Call Sign STL Maker"
  description="Create a print-ready 3D call sign in your browser. Adjust the size, spacing and base bar, then download an STL or SVG."
>
  <section class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-8 max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Call Sign STL Maker</h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Type a call sign, download a print-ready STL. Everything runs in your browser, nothing is uploaded.
        </p>
      </div>

      <div class="stl-maker">
        <div class="card">
          <label class="tool-label" for="text">Call sign</label>
          <div class="row">
            <input id="text" type="text" value="2D0PEY" maxlength="14" spellcheck="false" autocomplete="off" autocapitalize="characters">
            <button id="dl" class="primary">Download STL</button>
            <button id="dlsvg" title="Flat outline for laser cutting">Download SVG</button>
          </div>
          <div class="view">
            <canvas id="cv" aria-label="Interactive 3D preview. Drag to rotate the call sign."></canvas>
            <div class="tools"><button id="vTop">Top</button><button id="vAng">Angled</button></div>
          </div>
          <div class="status" id="status" aria-live="polite">&nbsp;</div>

          <details>
            <summary>Settings (all in mm)</summary>
            <div class="grid">
              <label class="f">Letter height (capitals)<input id="cap" type="number" step="0.1" min="3"></label>
              <label class="f">Width stretch (x)<input id="stretch" type="number" step="0.01" min="0.3" max="3"></label>
              <label class="f">Extra letter spacing<input id="spacing" type="number" step="0.1"></label>
              <label class="f">Thickness (Z)<input id="thick" type="number" step="0.1" min="0.4"></label>
              <label class="chk"><input id="slash" type="checkbox"> Slashed zero</label>
              <label class="f">Zero slash width<input id="slashW" type="number" step="0.1" min="0.6"></label>
              <label class="chk"><input id="bar" type="checkbox"> Base bar</label>
              <label class="f">Bar depth below letters<input id="barDepth" type="number" step="0.1" min="0.5"></label>
              <label class="f">Bar trim each end (negative = longer)<input id="barInset" type="number" step="0.1"></label>
              <label class="f">Bar shift (+ right, - left)<input id="barShift" type="number" step="0.1"></label>
              <label class="f">Bar overlap into letters<input id="barOverlap" type="number" step="0.1" min="0.1"></label>
              <label class="f">J and Q tail sink into bar<input id="sink" type="number" step="0.1" min="0"></label>
            </div>
            <div class="row" style="margin-top:12px"><button id="reset">Reset to defaults</button></div>
            <p class="hint">The bar is centred on where the letters stand, and steps down under J and Q so their tails stay visible. Letters print lying flat, thickness is the Z height.</p>
          </details>
        </div>
        <p class="foot">Letters: Noto Serif ExtraBold (SIL Open Font License), stretched to match the original design. Supports A-Z, 0-9, / - . and space.</p>
        <noscript><p class="hint">JavaScript is required to generate and preview your call sign.</p></noscript>
      </div>
    </div>
  </section>

  <style>
.stl-maker {
  --tool-bg: #faf7f4;
  --tool-panel: #ffffff;
  --tool-ink: #222222;
  --tool-mute: #595959;
  --tool-line: #d9d9d9;
  --tool-accent: #64c864;
  --tool-accent-ink: #172217;
  --tool-view: #ecebe6;
  color: var(--tool-ink);
  font: 15px/1.45 var(--font-family-sans);
}
:global(.dark) .stl-maker {
  --tool-bg: #111827;
  --tool-panel: #1f2937;
  --tool-ink: #f3f4f6;
  --tool-mute: #d1d5db;
  --tool-line: #4b5563;
  --tool-view: #111827;
}
.stl-maker * { box-sizing: border-box; }
.stl-maker .card { background: var(--tool-panel); border: 1px solid var(--tool-line); border-radius: 16px; padding: 20px; }
.stl-maker .row { display: flex; gap: 10px; align-items: stretch; flex-wrap: wrap; }
.stl-maker .tool-label { display: block; color: var(--tool-mute); font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.stl-maker #text { flex: 1 1 220px; font: 600 30px/1.1 ui-monospace, "SF Mono", "Cascadia Mono", Consolas, Menlo, "Liberation Mono", monospace; font-variant-numeric: slashed-zero; letter-spacing: 2px; text-transform: uppercase; padding: 10px 14px; border: 1px solid var(--tool-line); border-radius: 10px; background: var(--tool-bg); color: var(--tool-ink); min-width: 0; }
.stl-maker button { font: inherit; font-weight: 600; border-radius: 10px; border: 1px solid var(--tool-line); background: var(--tool-panel); color: var(--tool-ink); padding: 10px 16px; cursor: pointer; white-space: nowrap; }
.stl-maker button:hover { border-color: var(--tool-mute); }
.stl-maker button:active:not(:disabled) { transform: translateY(1px); }
.stl-maker button.primary { background: var(--tool-accent); color: var(--tool-accent-ink); border-color: var(--tool-accent); font-size: 16px; padding: 10px 22px; }
.stl-maker button.primary:hover { background: #8dd88d; border-color: #8dd88d; }
.stl-maker button:disabled { opacity: .45; cursor: not-allowed; }
.stl-maker :is(button, input, summary):focus-visible { outline: 2px solid var(--tool-accent); outline-offset: 2px; }
.stl-maker .view { position: relative; margin-top: 14px; background: var(--tool-view); border: 1px solid var(--tool-line); border-radius: 12px; height: 400px; overflow: hidden; }
.stl-maker canvas { width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
.stl-maker canvas:active { cursor: grabbing; }
.stl-maker .tools { position: absolute; right: 10px; top: 10px; display: flex; gap: 6px; }
.stl-maker .tools button { padding: 5px 10px; font-size: 12px; font-weight: 600; }
.stl-maker .status { margin: 10px 2px 0; color: var(--tool-mute); font-size: 13px; min-height: 20px; }
.stl-maker .status b { color: var(--tool-ink); font-weight: 600; }
.stl-maker .warn { color: #92400e; }
:global(.dark) .stl-maker .warn { color: #fbbf24; }
.stl-maker .bad { color: #b91c1c; }
:global(.dark) .stl-maker .bad { color: #fca5a5; }
.stl-maker details { margin-top: 14px; }
.stl-maker summary { cursor: pointer; font-weight: 600; padding: 4px 0; }
.stl-maker .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px 16px; margin-top: 12px; }
.stl-maker label.f { display: flex; flex-direction: column; gap: 3px; font-size: 13px; color: var(--tool-mute); }
.stl-maker label.f input[type=number] { font: inherit; font-size: 15px; padding: 7px 9px; border: 1px solid var(--tool-line); border-radius: 8px; background: var(--tool-bg); color: var(--tool-ink); width: 100%; }
.stl-maker label.chk { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--tool-ink); }
.stl-maker input[type=checkbox] { accent-color: var(--tool-accent); }
.stl-maker .foot { margin-top: 16px; font-size: 12px; color: var(--tool-mute); }
.stl-maker .hint { font-size: 12px; color: var(--tool-mute); margin-top: 8px; }
@media (max-width: 640px) {
  .stl-maker .card { padding: 14px; }
  .stl-maker .view { height: 300px; }
  .stl-maker #text { font-size: 26px; }
}
</style>
