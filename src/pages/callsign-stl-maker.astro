      if (!g) continue;
      const toPath = ring => ring.map(p => ({ X: Math.round((pen + p[0] * sx) * S), Y: Math.round(p[1] * unit * S) }));
      const outerPaths = g.outers.map(toPath);
      for (const p of outerPaths) { paths.push(p); feet.push(p); }
      for (const ring of g.holes) paths.push(toPath(ring));
