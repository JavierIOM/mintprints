  <script is:inline>/* CallSign STL core: text -> union outline -> extruded mesh. Pure functions, no DOM. */
(function (root) {
  function ringArea(r) {
    let a = 0;
    for (let i = 0, n = r.length; i < n; i++) {
      const p = r[i], q = r[(i + 1) % n];
      a += p[0] * q[1] - q[0] * p[1];
    }
    return a / 2;
  }

  // opts: text, cap (mm), stretch, spacing (mm), thick (mm), bar (bool), barDepth, barOverlap, barInset (trim from the letters' feet), barShift (mm, + right), slash (bool), slashW (mm),
  //       sink (mm, how far a J or Q descender sinks into the notched bar)
  // CL = ClipperLib. Glyph rings keep TrueType winding (outer clockwise, counter anticlockwise), so a
  // non-zero union gives the right shape; the bar is wound the same way as the outer contours.
  const S = 1000; // clipper integer units per mm

  // x-extent of the rings at or below height lim (clipper units): vertices below it plus edges crossing it
  function spanBelow(rings, lim) {
    let x0 = Infinity, x1 = -Infinity;
    for (const r of rings) for (let i = 0; i < r.length; i++) {
      const p = r[i], q = r[(i + 1) % r.length];
      if (p.Y <= lim) { x0 = Math.min(x0, p.X); x1 = Math.max(x1, p.X); }
      if ((p.Y - lim) * (q.Y - lim) < 0) { const x = p.X + (q.X - p.X) * (lim - p.Y) / (q.Y - p.Y); x0 = Math.min(x0, x); x1 = Math.max(x1, x); }
    }
    return [x0, x1];
  }

  function outline(opts, G, CL) {
    const unit = opts.cap / G.cap;          // mm per font unit (vertical)
    const sx = unit * opts.stretch;         // mm per font unit (horizontal)
