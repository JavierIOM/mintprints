  function load() {
    let s = {};
    try { s = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
    return Object.assign({}, DEF, s, { text: DEF.text });
  }
  function save(o) { try { localStorage.setItem(KEY, JSON.stringify(o)); } catch (e) {} }
  function setUI(o) {
    $('text').value = o.text;
    NUM.forEach(k => $(k).value = o[k]);
    $('bar').checked = !!o.bar; $('slash').checked = !!o.slash;
  }
  function readUI() {
    const o = { text: $('text').value, bar: $('bar').checked, slash: $('slash').checked };
    NUM.forEach(k => { const v = parseFloat($(k).value); o[k] = isFinite(v) ? v : DEF[k]; });
    return o;
  }

  let model = null, view = { yaw: 0, tilt: 0.95 }, timer = 0;

  function rebuild() {
    const o = readUI();
    save(o);
    const clean = o.text.toUpperCase();
    const ignored = [...clean].filter(c => !GLYPHS.glyphs[c]);
    const st = $('status');
    o.cap = Math.max(3, o.cap); o.stretch = Math.max(0.3, o.stretch); o.thick = Math.max(0.4, o.thick);
    o.slashW = Math.max(0.6, o.slashW); o.barDepth = Math.max(0.5, o.barDepth); o.barOverlap = Math.max(0.1, o.barOverlap);
    o.sink = Math.max(0, o.sink);
    const { mp, barDepth } = CallSignCore.outline(o, GLYPHS, ClipperLib);
    if (!mp.length) {
      model = null; $('dl').disabled = true; $('dlsvg').disabled = true;
      st.innerHTML = 'Type a call sign (A-Z, 0-9, / - .)'; draw(); return;
    }
    const tris = CallSignCore.mesh(mp, o.thick, cdt);
    const s = CallSignCore.stats(tris);
    model = { mp, tris, o, w: s.max[0] - s.min[0], h: s.max[1] - s.min[1], d: s.max[2], name: clean };
    $('dl').disabled = false; $('dlsvg').disabled = false;
    let msg = '<b>' + model.w.toFixed(1) + ' &times; ' + model.h.toFixed(1) + ' &times; ' + model.d.toFixed(1) + ' mm</b> &middot; ' +
      s.tris.toLocaleString() + ' triangles &middot; ' + (s.badEdges ? '<span class="bad">mesh check failed (' + s.badEdges + ' open edges)</span>' : 'watertight');
    if (o.bar && barDepth > o.barDepth + 0.005) msg += ' &middot; <span class="warn">bar deepened to ' + barDepth.toFixed(1) + ' mm to fit the J/Q tails</span>';
    if (model.w > 250) msg += ' &middot; <span class="warn">wider than 250 mm, check your bed</span>';
    if (ignored.length) msg += ' &middot; <span class="warn">ignored: ' + ignored.map(c => c === ' ' ? 'space' : c).join(' ') + '</span>';
    st.innerHTML = msg;
    draw();
  }
  function queue() { clearTimeout(timer); timer = setTimeout(rebuild, 120); }

  function fname(ext) {
    const n = (model ? model.name : 'CALLSIGN').replace(/[^A-Z0-9.\-]/g, m => m === '/' ? '-' : '').replace(/ /g, '');
    return 'CallSign_' + (n || 'X') + '.' + ext;
  }
  function download(blob, name) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = name;
    document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1500);
  }
  $('dl').onclick = () => { if (model) download(new Blob([CallSignCore.stl(model.tris, model.name)], { type: 'model/stl' }), fname('stl')); };
  $('dlsvg').onclick = () => { if (model) download(new Blob([CallSignCore.svg(model.mp)], { type: 'image/svg+xml' }), fname('svg')); };

  // ---------- preview ----------
  const cv = $('cv'), ctx = cv.getContext('2d');
  function draw() {
    const dpr = window.devicePixelRatio || 1, W = cv.clientWidth, H = cv.clientHeight;
    if (cv.width !== Math.round(W * dpr) || cv.height !== Math.round(H * dpr)) { cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    if (!model) return;
    const t = model.tris, n = t.length / 9;
    const cx = model.w / 2, cy = model.h / 2, cz = model.d / 2;
    const cw = Math.cos(view.yaw), sw = Math.sin(view.yaw), ca = Math.cos(view.tilt), sa = Math.sin(view.tilt);
    const P = new Float32Array(n * 9), items = [];
    let x0 = 1e9, x1 = -1e9, y0 = 1e9, y1 = -1e9;
    const tf = (x, y, z, o) => {
      x -= cx; y -= cy; z -= cz;
      const xr = x * cw - y * sw, yr = x * sw + y * cw;
      const yy = yr * ca + z * sa, zz = -yr * sa + z * ca;
      P[o] = xr; P[o + 1] = yy; P[o + 2] = zz;
      if (xr < x0) x0 = xr; if (xr > x1) x1 = xr; if (yy < y0) y0 = yy; if (yy > y1) y1 = yy;
    };
    for (let i = 0; i < n; i++) {
      const b = i * 9;
      for (let k = 0; k < 3; k++) tf(t[b + k * 3], t[b + k * 3 + 1], t[b + k * 3 + 2], b + k * 3);
      const ux = P[b + 3] - P[b], uy = P[b + 4] - P[b + 1], uz = P[b + 5] - P[b + 2];
      const vx = P[b + 6] - P[b], vy = P[b + 7] - P[b + 1], vz = P[b + 8] - P[b + 2];
      let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
      const l = Math.hypot(nx, ny, nz); if (!l) continue;
      nx /= l; ny /= l; nz /= l;
      if (nz <= 0) continue;
      items.push([i, (P[b + 2] + P[b + 5] + P[b + 8]) / 3, nx, ny, nz]);
    }
    items.sort((a, b) => a[1] - b[1]);
    const pad = 28, sc = Math.min((W - pad * 2) / (x1 - x0 || 1), (H - pad * 2) / (y1 - y0 || 1));
    const ox = W / 2 - (x0 + x1) / 2 * sc, oy = H / 2 + (y0 + y1) / 2 * sc;
    const L = [-0.35, 0.45, 0.82], ll = Math.hypot(...L);
    const dark = document.documentElement.classList.contains('dark');
    const base = dark ? [141, 216, 141] : [77, 166, 77];
    ctx.lineWidth = 0.6; ctx.lineJoin = 'round';
    for (const it of items) {
      const b = it[0] * 9;
      const lam = Math.max(0, (it[2] * L[0] + it[3] * L[1] + it[4] * L[2]) / ll);
      const f = 0.42 + 0.58 * lam;
      const col = 'rgb(' + Math.round(base[0] * f) + ',' + Math.round(base[1] * f) + ',' + Math.round(base[2] * f) + ')';
      ctx.fillStyle = col; ctx.strokeStyle = col;
      ctx.beginPath();
      ctx.moveTo(ox + P[b] * sc, oy - P[b + 1] * sc);
      ctx.lineTo(ox + P[b + 3] * sc, oy - P[b + 4] * sc);
      ctx.lineTo(ox + P[b + 6] * sc, oy - P[b + 7] * sc);
      ctx.closePath(); ctx.fill(); ctx.stroke();
    }
  }
  let drag = null;
  cv.addEventListener('pointerdown', e => { drag = { x: e.clientX, y: e.clientY, yaw: view.yaw, tilt: view.tilt }; cv.setPointerCapture(e.pointerId); });
  cv.addEventListener('pointermove', e => {
    if (!drag) return;
    view.yaw = drag.yaw + (e.clientX - drag.x) * 0.008;
    view.tilt = Math.max(0, Math.min(1.5, drag.tilt + (e.clientY - drag.y) * 0.008));
    draw();
  });
  cv.addEventListener('pointerup', () => { drag = null; });
  cv.addEventListener('dblclick', () => { view = { yaw: 0, tilt: 0.95 }; draw(); });
  $('vTop').onclick = () => { view = { yaw: 0, tilt: 0 }; draw(); };
  $('vAng').onclick = () => { view = { yaw: 0, tilt: 0.95 }; draw(); };
  new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  window.addEventListener('resize', draw);

  // ---------- wiring ----------
  $('text').addEventListener('input', e => {
    const el = e.target, p = el.selectionStart;
    el.value = el.value.toUpperCase(); try { el.setSelectionRange(p, p); } catch (_) {}
    queue();
  });
  NUM.forEach(k => $(k).addEventListener('input', queue));
  $('bar').addEventListener('change', rebuild);
  $('slash').addEventListener('change', rebuild);
  $('reset').onclick = () => { const t = $('text').value; setUI(Object.assign({}, DEF, { text: t })); rebuild(); };
  $('text').addEventListener('keydown', e => { if (e.key === 'Enter') $('dl').click(); });

  setUI(load());
  rebuild();
})();
</script>
</Layout>
