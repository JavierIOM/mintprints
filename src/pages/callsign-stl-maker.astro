    const stub = 0.25 * capS;                                           // notches closer than this merge
    for (const d of drops) barDepth = Math.max(barDepth, (floor - d.low - sink) / S);   // deepen rather than let a tail poke through
    const bx0 = Math.round(f0 + opts.barInset * S + sh), bx1 = Math.round(f1 - opts.barInset * S + sh);
    const by0 = Math.round(-barDepth * S), by1 = Math.round(opts.barOverlap * S);
