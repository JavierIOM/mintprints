    const paths = [];
    const feet = [];                         // outer-contour polygons, for the baseline footprint
    const drops = [];                        // descenders the bar must step down under: { x0, x1, low }
    const area = r => { let a = 0; for (let i = 0; i < r.length; i++) { const p = r[i], q = r[(i + 1) % r.length]; a += p.X * q.Y - q.X * p.Y; } return a / 2; };
