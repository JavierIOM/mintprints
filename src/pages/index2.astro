---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const services = [
  {
    title: "FDM (Plastic) Printing",
    description: "High-quality thermoplastic printing using PLA, PETG, ASA, and TPU. Perfect for modelling, prototyping, and low-volume finished products.",
    icon: `<svg class="w-8 h-8 text-christmas-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>`
  },
  {
    title: "SLA (Resin) Printing",
    description: "Incredibly detailed models using UV laser technology. Ideal for wargamers, miniatures, and anything requiring precision at 30mm scale and beyond.",
    icon: `<svg class="w-8 h-8 text-christmas-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`
  },
  {
    title: "Laser Cutting & Etching",
    description: "Precision work with our 80-watt CO2 laser and 700x500mm workbed. Personalise wood, glass, perspex, slate and more with custom designs.",
    icon: `<svg class="w-8 h-8 text-christmas-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Custom Design",
    description: "Original artwork and bespoke designs tailored to your needs. From concept to creation, we bring your ideas to life.",
    icon: `<svg class="w-8 h-8 text-christmas-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>`
  }
];
---

<Layout title="Home">
  <!-- Christmas Hero Section -->
  <section class="relative bg-gradient-to-br from-red-50 via-white to-green-50 dark:from-gray-900 dark:via-red-950/20 dark:to-green-950/20 py-20 md:py-32 overflow-hidden">
    <!-- Snowflakes decoration -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="snowflake absolute text-4xl opacity-70">❄</div>
      <div class="snowflake absolute text-3xl opacity-60" style="left: 20%; animation-delay: 1s;">❄</div>
      <div class="snowflake absolute text-5xl opacity-50" style="left: 40%; animation-delay: 2s;">❄</div>
      <div class="snowflake absolute text-3xl opacity-70" style="left: 60%; animation-delay: 0.5s;">❄</div>
      <div class="snowflake absolute text-4xl opacity-60" style="left: 80%; animation-delay: 1.5s;">❄</div>
      <div class="snowflake absolute text-3xl opacity-50" style="left: 90%; animation-delay: 2.5s;">❄</div>
    </div>

    <div class="max-w-6xl mx-auto px-4 text-center relative z-10">
      <!-- Christmas decoration -->
      <div class="mb-6 flex justify-center gap-4">
        <span class="text-5xl animate-bounce" style="animation-delay: 0s;">🎄</span>
        <span class="text-5xl animate-bounce" style="animation-delay: 0.2s;">⭐</span>
        <span class="text-5xl animate-bounce" style="animation-delay: 0.4s;">🎄</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6">
        Where all your prints are <span class="text-christmas-red">Mint!</span>
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-4">
        Professional 3D printing, laser cutting, and custom design services.
        From prototypes to finished products, we bring your ideas to life.
      </p>
      <p class="text-2xl font-bold text-christmas-red dark:text-christmas-gold mb-10">
        🎁 Perfect for Christmas Gifts! 🎁
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-christmas-red text-white font-semibold rounded-xl hover:bg-red-700 transition-colors shadow-lg">
          Get in Touch
        </a>
        <a href="/gallery" class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-gray-800 text-christmas-green dark:text-christmas-gold font-semibold rounded-xl border-2 border-christmas-green dark:border-christmas-gold hover:bg-christmas-green hover:text-white dark:hover:bg-christmas-gold dark:hover:text-gray-900 transition-colors shadow-lg">
          View Our Work
        </a>
      </div>
    </div>
  </section>

  <!-- Services Section with Christmas Theme -->
  <section class="py-20 bg-gradient-to-br from-green-50 to-red-50 dark:from-gray-800/50 dark:to-gray-800/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-16">
        <div class="mb-4">
          <span class="text-4xl">🎅</span>
          <span class="text-4xl mx-2">🎁</span>
          <span class="text-4xl">🤶</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Our Services</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          From rapid prototyping to bespoke finished products, we offer a range of services to meet your needs.
        </p>
        <p class="text-lg font-semibold text-christmas-red dark:text-christmas-gold mt-2">
          ✨ Make this Christmas special with custom creations! ✨
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Christmas CTA Section -->
  <section class="relative py-20 bg-gradient-to-r from-christmas-red via-christmas-green to-christmas-red overflow-hidden">
    <!-- Festive overlay -->
    <div class="absolute inset-0 bg-black/10"></div>

    <!-- More snowflakes -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="snowflake absolute text-3xl" style="left: 10%; animation-delay: 0.3s;">⭐</div>
      <div class="snowflake absolute text-4xl" style="left: 30%; animation-delay: 1.2s;">❄</div>
      <div class="snowflake absolute text-3xl" style="left: 50%; animation-delay: 2.1s;">⭐</div>
      <div class="snowflake absolute text-4xl" style="left: 70%; animation-delay: 0.8s;">❄</div>
      <div class="snowflake absolute text-3xl" style="left: 85%; animation-delay: 1.8s;">⭐</div>
    </div>

    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      <div class="mb-4 flex justify-center gap-3">
        <span class="text-5xl">🎄</span>
        <span class="text-5xl">🎁</span>
        <span class="text-5xl">🎄</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ready to start your Christmas project?</h2>
      <p class="text-xl text-white/95 mb-4">
        Get in touch and let's discuss how we can bring your ideas to life.
      </p>
      <p class="text-lg text-white/90 font-semibold mb-10">
        🎅 Order now for Christmas delivery! 🎄
      </p>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-christmas-red font-semibold rounded-xl hover:bg-gray-100 transition-colors shadow-xl">
        Contact Us Today
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Christmas color variables */
  :global(.text-christmas-red) {
    color: #c41e3a;
  }

  :global(.bg-christmas-red) {
    background-color: #c41e3a;
  }

  :global(.text-christmas-green) {
    color: #0f7e4d;
  }

  :global(.bg-christmas-green) {
    background-color: #0f7e4d;
  }

  :global(.text-christmas-gold) {
    color: #ffd700;
  }

  :global(.bg-christmas-gold) {
    background-color: #ffd700;
  }

  :global(.border-christmas-green) {
    border-color: #0f7e4d;
  }

  :global(.border-christmas-gold) {
    border-color: #ffd700;
  }

  /* Snowfall animation */
  @keyframes snowfall {
    0% {
      transform: translateY(-10vh) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      transform: translateY(110vh) rotate(360deg);
      opacity: 0;
    }
  }

  .snowflake {
    animation: snowfall 10s linear infinite;
    color: #e0f2fe;
    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.8));
  }

  /* Prevent snowflakes from affecting layout */
  .snowflake {
    position: absolute;
    user-select: none;
  }
</style>
