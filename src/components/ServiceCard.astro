---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
  <div class="w-16 h-16 bg-mint/10 rounded-xl flex items-center justify-center mb-6">
    <Fragment set:html={icon} />
  </div>
  <h3 class="text-xl font-semibold text-gray-900 mb-3">{title}</h3>
  <p class="text-gray-600 leading-relaxed">{description}</p>
</div>
