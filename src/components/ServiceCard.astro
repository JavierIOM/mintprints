---
interface Props {
  title: string;
  description: string;
  icon: string;
  tag: string;
  href?: string;
}

const {
  title,
  description,
  icon,
  tag,
  href = '/contact/'
} = Astro.props;
---

<article class="service-card corner-frame">
  <div class="service-card__meta">
    <span class="service-card__icon" aria-hidden="true">
      <Fragment set:html={icon} />
    </span>
    <span class="technical-label">{tag}</span>
  </div>

  <h3 class="service-card__title">{title}</h3>
  <p class="service-card__copy">{description}</p>

  <div class="service-card__footer">
    <a href={href} class="text-link">
      Discuss this service
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4-4 4M3 12h18" />
      </svg>
    </a>
  </div>
</article>
