---
---

<button
  data-theme-toggle
  class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:text-mint dark:hover:text-mint transition-colors focus-visible:ring-2 focus-visible:ring-mint focus-visible:ring-offset-2 outline-none"
  aria-label="Toggle dark mode"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg data-sun-icon class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg data-moon-icon class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
  </svg>
</button>

<script>
  function updateIcons(btn: HTMLElement, isDark: boolean) {
    const sun = btn.querySelector('[data-sun-icon]');
    const moon = btn.querySelector('[data-moon-icon]');
    sun?.classList.toggle('hidden', !isDark);
    moon?.classList.toggle('hidden', isDark);
  }

  const toggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
  const html = document.documentElement;

  toggles.forEach(btn => {
    updateIcons(btn, html.classList.contains('dark'));
    btn.addEventListener('click', () => {
      const isDarkNow = html.classList.toggle('dark');
      localStorage.setItem('theme', isDarkNow ? 'dark' : 'light');
      toggles.forEach(b => updateIcons(b, isDarkNow));
    });
  });
</script>
