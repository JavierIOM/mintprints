---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 py-12">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl font-bold text-mint">Mint</span>
          <span class="text-2xl font-bold text-white">Prints</span>
        </div>
        <p class="text-gray-400">Where all your prints are Mint!</p>
        <p class="text-gray-400 mt-2">3D Printing, Laser Cutting & Custom Design</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-semibold text-white mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-mint transition-colors">Home</a></li>
          <li><a href="/gallery" class="hover:text-mint transition-colors">Gallery</a></li>
          <li><a href="/testimonials" class="hover:text-mint transition-colors">Testimonials</a></li>
          <li><a href="/contact" class="hover:text-mint transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Connect -->
