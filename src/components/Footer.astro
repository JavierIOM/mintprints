---
import pkg from '../../package.json';

const currentYear = new Date().getFullYear();
const version = pkg.version;

const links = [
  { href: '/', label: 'Home' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/equipment/', label: 'Equipment' },
  { href: '/testimonials/', label: 'Reviews' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];

const services = ['FDM printing', 'SLA resin printing', 'Laser cutting', 'Custom design'];

const socials = [
  { href: 'https://www.instagram.com/mintprintsiom/', label: 'Instagram' },
  { href: 'https://www.facebook.com/mintprintsiom', label: 'Facebook' },
  { href: 'https://www.etsy.com/shop/MintPrintsIOM', label: 'Etsy' },
  { href: 'https://www.redbubble.com/people/manxcraft/shop', label: 'Redbubble' },
];
---

<footer class="surface-invert">
  <div class="site-container section-tight">
    <div class="footer-grid">
      <div>
        <a href="/" class="brand-lockup text-2xl" aria-label="Mint Prints home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Mint Prints</span>
        </a>
        <p class="mt-5 max-w-sm text-[0.95rem] leading-7 text-[#f4f4ee]/70">
          Where all your prints are Mint. Professional 3D printing, laser cutting, and custom design from the Isle of Man.
        </p>
        <div class="mt-6 flex flex-wrap gap-2" aria-label="Services">
          {services.map(service => (
            <span class="border border-[#f4f4ee]/15 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-[#f4f4ee]/64">
              {service}
            </span>
          ))}
        </div>
      </div>

      <div>
        <h2 class="technical-label mb-5">Navigate</h2>
        <ul class="space-y-3">
          {links.map(link => (
            <li>
              <a href={link.href} class="footer-link text-sm font-semibold">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="technical-label mb-5">Contact</h2>
        <div class="space-y-4 text-sm text-[#f4f4ee]/70">
          <p>
            <a href="mailto:info@mintprints.im" class="footer-link font-semibold">info@mintprints.im</a>
          </p>
          <p>Isle of Man</p>
          <div class="flex flex-wrap gap-2 pt-2">
            {socials.map(social => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener"
                class="border border-[#f4f4ee]/15 px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-[#f4f4ee]/70 hover:border-[#58b368] hover:text-[#58b368]"
              >
                {social.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-[#f4f4ee]/12 pt-6 text-sm text-[#f4f4ee]/52 md:flex-row md:items-center md:justify-between">
      <p>&copy; {currentYear} Mint Prints. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="/privacy/" class="footer-link">Privacy</a>
        <a href="/terms/" class="footer-link">Terms</a>
      </div>
      <p class="font-mono text-xs uppercase tracking-[0.14em]">v{version}</p>
    </div>
  </div>
</footer>
