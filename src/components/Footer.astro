        </div>
        <p class="text-gray-400">
          <a href="mailto:info@mintprints.im" class="hover:text-mint transition-colors">info@mintprints.im</a>
        </p>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-500">
      <p>&copy;{currentYear} Mint Prints. All Rights Reserved.</p>
      <p class="text-xs mt-2">v{version}</p>
    </div>
  </div>
</footer>
