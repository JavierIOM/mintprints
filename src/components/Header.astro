const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header-shell sticky top-0 z-50">
  <nav class="site-container py-4" aria-label="Main navigation">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="brand-lockup text-xl md:text-2xl" aria-label="Mint Prints home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Mint Prints</span>
      </a>

      <ul class="hidden lg:flex items-center gap-8">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="nav-link"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="hidden lg:flex items-center gap-3">
        <div class="flex items-center gap-1" aria-label="Social profiles">
          {socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              class="inline-flex h-10 w-10 items-center justify-center text-[#6e7470] hover:text-[#2f6f3d] dark:text-[#aab1aa] dark:hover:text-[#58b368]"
              aria-label={link.label}
            >
              <svg class="h-[1.1rem] w-[1.1rem]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={link.path}></path>
              </svg>
            </a>
          ))}
        </div>
        <ThemeToggle />
        <a href="/contact/" class="button button-primary min-h-[2.75rem] px-5 py-2 text-sm">
          Get a quote
        </a>
      </div>

      <div class="flex lg:hidden items-center gap-2">
        <ThemeToggle />
        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center border border-[#d7dbd3] text-[#1f211f] dark:border-[#3a3f3a] dark:text-[#f4f4ee]"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-[#d7dbd3] pt-4 mt-4 dark:border-[#3a3f3a]">
      <ul class="flex flex-col gap-4">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                "block py-1 text-2xl font-extrabold tracking-[-0.04em] text-[#1f211f] dark:text-[#f4f4ee]",
                { "text-[#2f6f3d] dark:text-[#58b368]": isActive(link.href) }
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact/" class="button button-primary mt-5 w-full">
        Start your project
      </a>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(isOpen));
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
